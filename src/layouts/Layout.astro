---
import '../styles/globals.css';
import github from '../assets/github.svg';
import linkedin from '../assets/linkedin.svg';
import mail from '../assets/mail.svg';

interface Props {
	title: string;
    description?: string;
    image?: string;
    type?: 'website' | 'article';
    publishedDate?: Date;
    updatedDate?: Date;
    keywords?: string;
}

const {
    title,
    description = "Senior, freelance IT consultant specialized within .NET and Episerver Commerce (now Optimizely) located in Stockholm, Sweden",
    image,
    type = 'website',
    publishedDate,
    updatedDate,
    keywords = "optimizely, episerver, yarp, filebeat, fluentvalidation, partytown, caching, web vitals, web performance"
} = Astro.props;

const PUBLIC_OPTIMIZE = import.meta.env.PUBLIC_OPTIMIZE;
const PUBLIC_GTM = import.meta.env.PUBLIC_GTM;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = 'https://andreas.jilvero.se';
const ogImage = image ? (image.startsWith('http') ? image : `${siteURL}${image}`) : undefined;

const jsonLdBase = {
    "@context": "https://schema.org",
    "@type": type === 'article' ? "BlogPosting" : "WebSite",
    "url": canonicalURL.toString(),
    "name": title,
    "description": description,
};

const jsonLdArticle = type === 'article' ? {
    ...jsonLdBase,
    "headline": title,
    ...(ogImage ? { "image": ogImage } : {}),
    "datePublished": publishedDate?.toISOString(),
    "dateModified": (updatedDate ?? publishedDate)?.toISOString(),
    "author": {
        "@type": "Person",
        "name": "Andreas Jilvero",
        "url": siteURL,
        "sameAs": [
            "https://www.linkedin.com/in/andreas-jilvero-51b8474a/",
            "https://github.com/AndreasJilvero"
        ]
    },
    "publisher": {
        "@type": "Organization",
        "name": "Andreas Jilvero AB",
        "url": siteURL
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalURL.toString()
    }
} : {
    ...jsonLdBase,
    "author": {
        "@type": "Person",
        "name": "Andreas Jilvero",
        "url": siteURL,
        "sameAs": [
            "https://www.linkedin.com/in/andreas-jilvero-51b8474a/",
            "https://github.com/AndreasJilvero"
        ]
    }
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
        {PUBLIC_OPTIMIZE && (
            <script is:inline src={`https://www.googleoptimize.com/optimize.js?id=${PUBLIC_OPTIMIZE}`}></script>
        )}
        {PUBLIC_GTM && (
            <script is:inline define:vars={{ PUBLIC_GTM }}>
                (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                })(window,document,'script','dataLayer', PUBLIC_GTM);
            </script>
        )}
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

        <link rel="canonical" href={canonicalURL} />

        <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro&display=swap" rel="stylesheet" />

        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />

        <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {ogImage && <meta property="og:image" content={ogImage} />}
        {ogImage && <meta property="og:image:width" content="1200" />}
        {ogImage && <meta property="og:image:height" content="630" />}
        <meta property="og:locale" content="en_US" />
        <meta property="og:site_name" content="Andreas Jilvero AB" />
        {type === 'article' && publishedDate && (
            <meta property="article:published_time" content={publishedDate.toISOString()} />
        )}
        {type === 'article' && (updatedDate ?? publishedDate) && (
            <meta property="article:modified_time" content={(updatedDate ?? publishedDate)!.toISOString()} />
        )}
        {type === 'article' && (
            <meta property="article:author" content="Andreas Jilvero" />
        )}

        <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:url" content={Astro.url} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}

        <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />

        <script is:inline>
            window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
        </script>
        <script defer src="/_vercel/insights/script.js"></script>
	</head>
	<body class="md:pl-16 bg-gray-100">
        {PUBLIC_GTM && (
            <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${PUBLIC_GTM}`}
            height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        )}
		<div class="bg-white p-8 md:px-16 md:w-[1000px] w-full min-h-screen mx-auto md:mx-0">
            <div>
                <slot />
            </div>

            <footer class='mt-8 pt-8 grid justify-between grid-cols-1 md:grid-cols-2 gap-3 md:gap-0 border-t'>
                <div class=''>
                    Andreas Jilvero AB<br />
                </div>
                <div class='md:text-right'>
                    Organisationsnummer: 559237-3004<br />
                    Phone number: 076 035 90 11
                </div>
            </footer>
            <ul class='ml-0 py-4 flex flex-row gap-x-8 justify-center bg-white'>
                <li class='p-2 rounded-md transition ease-in-out hover:bg-green-300 duration-300'>
                    <a href="mailto:andreas.jilvero@gmail.com">
                        <img src={mail.src} alt="Mail" class="h-10" />
                    </a>
                </li>
                <li class='p-2 rounded-md transition ease-in-out hover:bg-green-300 duration-300'>
                    <a href="https://github.com/AndreasJilvero">
                        <img src={github.src} alt="Github" class="h-10" />
                    </a>
                </li>
                <li class='p-2 rounded-md transition ease-in-out hover:bg-green-300 duration-300'>
                    <a href="https://www.linkedin.com/in/andreas-jilvero-51b8474a/">
                        <img src={linkedin.src} alt="LinkedIn" class="h-10" />
                    </a>
                </li>
            </ul>
        </div>
	</body>
</html>
